#!/bin/bash
# cell-watchdog - keep the NetworkManager cellular connection (kiwisim / ppp0) actually passing traffic.
#
# NetworkManager can show the connection "activated" while no data flows (seen 2026-10-04 after the network
# hung up the PPP session and NetworkManager re-dialed straight away). pppd can't detect that because the
# modem answers PPP itself, so this checks at the IP level and escalates:
#   1. re-activate the NetworkManager connection
#   2. restart ModemManager            (at most once per HEAVY_BACKOFF)
#   3. reset the modem (mmcli --reset) (at most once per HEAVY_BACKOFF)
# Run by cell-watchdog.timer every few minutes, and by the NetworkManager hook (90-cell-watchdog) when wlan0
# goes down and 30 s after the cellular connection comes up.
# Logs: journalctl -u cell-watchdog

set -u

CON=kiwisim
IFACE=ppp0
TARGETS=(8.8.8.8 1.1.1.1)
RX_ALIVE_BYTES=2000      # received this much since the last check -> link is alive, no ping needed
HEAVY_BACKOFF=1800       # seconds between ModemManager restarts / modem resets
STATE=/run/cell-watchdog # rx_bytes: ppp0 counter at the last check; last_heavy: time of the last heavy step

con_state() { nmcli -g GENERAL.STATE con show "$CON" 2>/dev/null; }

# Up to 4 single pings (stop at the first reply): the first one or two are often lost while Cat-M wakes up.
link_ok() {
    local i
    [[ -e /sys/class/net/$IFACE ]] || return 1
    for i in 0 1 2 3; do
        ping -n -q -c 1 -W 8 -I "$IFACE" "${TARGETS[i % ${#TARGETS[@]}]}" >/dev/null 2>&1 && return 0
    done
    return 1
}

# wait_active SECONDS: wait for the connection to be activated.
wait_active() {
    local end=$((SECONDS + $1))
    while (( SECONDS < end )); do
        [[ $(con_state) == activated ]] && return 0
        sleep 3
    done
    return 1
}

recovered() { echo "recovered after: $1"; exit 0; }

# Paused on purpose (connect_minicom.sh / cell_net_test.sh) or not set up: leave it alone.
if ! systemctl is-active --quiet ModemManager; then
    echo "ModemManager isn't running (paused by a script?), skipping"
    exit 0
fi
if ! nmcli -g connection.id con show "$CON" >/dev/null 2>&1; then
    echo "no NetworkManager connection '$CON', skipping"
    exit 0
fi

mkdir -p "$STATE"
rx=$(cat "/sys/class/net/$IFACE/statistics/rx_bytes" 2>/dev/null || echo 0)
last=$(cat "$STATE/rx_bytes" 2>/dev/null || echo -1)   # -1 (no file) forces a ping
echo "$rx" >"$STATE/rx_bytes"

# NetworkManager is still bringing it up on its own: give that a chance first.
[[ $(con_state) == activating ]] && wait_active 60

if [[ $(con_state) == activated ]]; then
    (( last >= 0 && rx - last >= RX_ALIVE_BYTES )) && exit 0   # real traffic since the last check
    link_ok && exit 0
fi

# Tell the NetworkManager hook not to schedule extra checks for the re-activations we cause.
touch "$STATE/recovering"
trap 'rm -f "$STATE/recovering"' EXIT

echo "cellular link not working (connection state: '$(con_state)'); step 1: re-activating '$CON'"
nmcli --wait 60 con up "$CON" >/dev/null 2>&1
wait_active 30 && link_ok && recovered "re-activating '$CON'"

now=$(date +%s)
last_heavy=$(cat "$STATE/last_heavy" 2>/dev/null || echo 0)
if (( now - last_heavy < HEAVY_BACKOFF )); then
    echo "still down; ModemManager restart / modem reset was already tried $(( (now - last_heavy) / 60 )) min ago, waiting"
    exit 1
fi
echo "$now" >"$STATE/last_heavy"

systemctl is-active --quiet ModemManager || exit 0   # someone paused it in the meantime
echo "step 2: restarting ModemManager"
systemctl restart ModemManager
wait_active 120 && link_ok && recovered "restarting ModemManager"

echo "step 3: resetting the modem"
mmcli -m any --reset >/dev/null 2>&1 || echo "mmcli --reset failed (is the modem on USB? check: lsusb, dmesg | tail)"
wait_active 180 && link_ok && recovered "resetting the modem"

echo "still down after all recovery steps (no coverage? account? check: mmcli -m any, ./cell_net_test.sh)"
rm -f "$STATE/rx_bytes"   # make the next run ping again
exit 1
